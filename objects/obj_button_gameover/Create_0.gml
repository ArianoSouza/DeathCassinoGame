switch (b_type){

			case "exit":
				image_xscale = (string_width("Exit")+(16))/sprite_get_width(spr_card_game_button) 
				image_yscale = (string_height("Exit")+(16))/sprite_get_height(spr_card_game_button) 
			break
	
			case "Go to menu":
					image_xscale = (string_width("Go to menu")+(16))/sprite_get_width(spr_card_game_button) 
					image_yscale = (string_height("Go to menu")+(16))/sprite_get_height(spr_card_game_button) 
			break


	}
	
