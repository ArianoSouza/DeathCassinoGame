

switch (b_type){

			case "down":
				image_xscale = (string_width("Go 'Down There'")+(16))/sprite_get_width(spr_card_game_button) 
				image_yscale = (string_height("Go 'Down There'")+(16))/sprite_get_height(spr_card_game_button) 
			break
	
			case "up":
					image_xscale = (string_width("Go 'Up There'")+(16))/sprite_get_width(spr_card_game_button) 
					image_yscale = (string_height("Go 'Up There'")+(16))/sprite_get_height(spr_card_game_button) 
			break
			
			case "earth":
					image_xscale = (string_width("Another chance")+(16))/sprite_get_width(spr_card_game_button) 
					image_yscale = (string_height("Another chance")+(16))/sprite_get_height(spr_card_game_button) 
			break


	}
	
